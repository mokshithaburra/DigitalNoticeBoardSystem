<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Digital Notice Board</display-name>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.digitalnoticeboard.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CreateNoticeServlet</servlet-name>
        <servlet-class>com.digitalnoticeboard.servlet.CreateNoticeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CreateNoticeServlet</servlet-name>
        <url-pattern>/notice/create</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EditNoticeServlet</servlet-name>
        <servlet-class>com.digitalnoticeboard.servlet.EditNoticeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EditNoticeServlet</servlet-name>
        <url-pattern>/notice/edit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteNoticeServlet</servlet-name>
        <servlet-class>com.digitalnoticeboard.servlet.DeleteNoticeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteNoticeServlet</servlet-name>
        <url-pattern>/notice/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ListNoticesServlet</servlet-name>
        <servlet-class>com.digitalnoticeboard.servlet.ListNoticesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ListNoticesServlet</servlet-name>
        <url-pattern>/admin/notices</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ListNoticesServlet</servlet-name>
        <url-pattern>/student/notices</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>NoticeAPI</servlet-name>
        <servlet-class>com.digitalnoticeboard.servlet.NoticeAPI</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NoticeAPI</servlet-name>
        <url-pattern>/api/notices</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminNoticeAPI</servlet-name>
        <servlet-class>com.digitalnoticeboard.servlet.AdminNoticeAPI</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminNoticeAPI</servlet-name>
        <url-pattern>/api/admin/notices</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.digitalnoticeboard.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
</web-app>
